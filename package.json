{
  "name": "qaddumi-electronics",
  "version": "1.0.0",
  "description": "Qaddumi Electronics & Appliances - Bilingual E-commerce Catalog",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "pnpm --filter api start",
    "preview": "pnpm --filter web preview",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "type-check": "pnpm --filter web type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supabase": "^1.100.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}