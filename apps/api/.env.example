# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Configuration
VITE_API_URL=http://localhost:3001
NODE_ENV=development
PORT=3001

# Frontend Configuration
VITE_ENABLE_CART=false
VITE_WHATSAPP_NUMBER=+970591234567
VITE_STORE_PHONE=+97092345678
VITE_STORE_EMAIL=info@qaddumi.ps
VITE_STORE_ADDRESS="طولكرم، فلسطين"

# Analytics & Tracking (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=123456789
VITE_HOTJAR_ID=123456

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
